{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "usbmeter",
  "compatibility_date": "2026-09-11",
  // Static assets only, no Worker script. All the work happens in the browser.
  //   pnpm run deploy  →  vite build && wrangler deploy
  "assets": {
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}
